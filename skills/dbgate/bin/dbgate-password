#!/bin/bash
# DbGate 접속의 DB 비밀번호를 전용 키체인 항목(dbgate/<id>)에 넣는다. 사람이 터미널에서 직접 실행한다.
#   dbgate-password      접속 목록에서 번호를 골라 비밀번호를 넣는다 (keychain 칸이 있는 접속만)
# 비밀번호는 security 가 직접 입력받는다(화면에 보이지 않음). 이 스크립트는 값을 읽거나 출력하지 않는다.
# security 로 만든 항목이라 DbGate 가 켜질 때 허용 창 없이 읽힌다. 다음 dbgate 실행부터 적용된다.
LIST="${DBGATE_CONNECTIONS:-$HOME/.claude/ops-agent/dbgate/connections.json}"

rows=$(python3 -I -c 'import json,sys
conns=[c for c in json.load(open(sys.argv[1])) if c.get("keychain") and not c.get("removed")]
for i,c in enumerate(conns,1):
    print("\t".join([str(i), c["keychain"], c.get("user") or "default", c.get("folder") or "-", c["label"]]))' "$LIST")
echo "$rows" | awk -F'\t' '{printf "%3s  %-28s %s\n", $1, $4, $5}'
read -r -p "번호 (여러 개는 공백으로 구분): " picks
for n in $picks; do
  line=$(echo "$rows" | awk -F'\t' -v n="$n" '$1==n')
  [ -z "$line" ] && { echo "$n: 없는 번호"; continue; }
  service=$(echo "$line" | cut -f2); account=$(echo "$line" | cut -f3); label=$(echo "$line" | cut -f5)
  echo "[$label] DB 비밀번호를 두 번 입력합니다"
  # -w 를 마지막에 값 없이 두면 security 가 직접 묻는다. -U 는 있으면 바꾼다. -T 는 security 가 창 없이 읽게 한다.
  if security add-generic-password -U -s "$service" -a "$account" -l "DbGate $label" -T /usr/bin/security -w; then
    echo "[$label] 저장"
  else
    echo "[$label] 실패"
  fi
done
